<?xml version="1.0" encoding="utf-8"?>
<!--
    The window, before Compose fills it.

    Nothing here styles the app: what the user sees is drawn by the shared UI,
    which brings its own colors and its own dark mode. This is what the system
    needs to open a window at all, and what it draws in the moment before the
    first frame.
-->
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light" />

    <!-- No title bar: the app draws its own, and one behind it is not a title. -->
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- The app draws under the status bar, as it does on iOS. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
