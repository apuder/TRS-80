<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        The advertising id, which this app does not want and never asked for.

        firebase-analytics merges both of these in on its own. Play then reads
        the manifest, sees an app that can read the advertising id, and refuses
        the declaration that says it does not - answering "no" is rejected as
        untrue however many times it is answered.

        Removing them makes "no" true, and costs only what this app was never
        doing: attributing installs to adverts and exporting audiences to ad
        platforms. Ordinary analytics is unaffected.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />

    <application
        android:name=".TRS80Application"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/AppTheme" >
        <!--
            The app. Everything it draws is the shared Compose UI.

            configChanges rather than letting the system recreate it: a running
            machine lives in the composition, and being recreated would stop the
            CPU and boot it again from its last save. Turning the device is not
            supposed to cost the user their game.
        -->
        <activity
            android:name=".Trs80Activity"
            android:label="@string/app_name"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>
    </application>

</manifest>
