{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": [
    {
      "target": "receiver",
      "public": "var/googlecast-receiver/"
    },
    {
      "target": "web",
      "public": "shared/build/dist/wasmJs/productionExecutable",
      "ignore": [
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "/privacy-ios",
          "destination": "/privacy-ios.html"
        },
        {
          "source": "/privacy-android",
          "destination": "/privacy-android.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/!(trs80core).wasm",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    }
  ]
}
